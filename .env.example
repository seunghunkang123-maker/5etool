# ─────────────────────────────────────────────────────────────
# 클라이언트 환경 변수 (VITE_ 접두사만 번들에 포함됨)
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL과 anon(publishable) 키.
# 두 값이 모두 비어 있으면 앱은 "데모 모드"(브라우저 로컬 저장소)로 실행된다.
# anon 키는 공개되어도 안전한 키다. 실제 접근 제어는 RLS가 담당한다.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# 강제로 데모 모드를 켜고 싶을 때 "true"로 설정한다 (E2E 테스트용)
VITE_FORCE_DEMO=""

# ─────────────────────────────────────────────────────────────
# 서버 전용 (Supabase Edge Function 시크릿)
# 절대로 VITE_ 접두사를 붙이지 말 것. 클라이언트 번들에 포함되면 안 된다.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY="sk-ant-..."

# 사용할 모델 (기본값: claude-opus-5)
# AI_MODEL="claude-opus-5"

# 사용자 1명이 1시간 동안 호출할 수 있는 AI 생성 횟수 (기본값: 20, 0 이하면 제한 없음)
# AI_RATE_LIMIT_PER_HOUR="20"

# 외부 AI API 호출 타임아웃 (밀리초, 기본값: 90000)
# AI_TIMEOUT_MS="90000"

# Edge Function CORS 허용 출처. 비워 두면 모든 출처를 허용한다(개발용).
# 운영 환경에서는 반드시 배포 도메인을 지정할 것.
# ALLOWED_ORIGINS="https://example.com"

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는
# Supabase가 Edge Function 런타임에 자동으로 주입하므로 별도로 설정하지 않는다.
